# انسخ هذا الملف إلى .env (لا يُرفع إلى المستودع) ثم عبّئ القيم.
# كل القيم اختيارية؛ التطبيق يعمل بدونها ما عدا الميزة المرتبطة بها.

# ---- الخادم ----
HOST=127.0.0.1
PORT=8765
# ضع 1 فقط إذا كان التطبيق خلف HTTPS (يضيف خاصية Secure لملف الجلسة)
COOKIE_SECURE=0

# ---- واتساب: WhatsApp Business Platform (Cloud API) الرسمية ----
# رمز وصول دائم لمستخدم نظام (System User) من Meta Business
WHATSAPP_ACCESS_TOKEN=
# معرّف رقم الهاتف (Phone Number ID) وليس الرقم نفسه
WHATSAPP_PHONE_NUMBER_ID=
# إصدار Graph API — راجع وثائق Meta واكتب الإصدار الحالي المدعوم
WHATSAPP_API_VERSION=v21.0
# اختياري: قالب رسائل معتمد من Meta (لازم للإرسال خارج نافذة 24 ساعة)
# يجب أن يحتوي نص القالب على متغير واحد {{1}} يوضع فيه نص الرسالة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# ---- المنظِّم الذكي (اختياري) ----
# بدون مفتاح: يعمل المنظِّم القاعدي المحلي (لا يرسل أي بيانات للخارج).
# مع المفتاح + تثبيت الحزمة (pip install anthropic): تُرسل الملاحظات الخام إلى Claude API.
ANTHROPIC_API_KEY=
