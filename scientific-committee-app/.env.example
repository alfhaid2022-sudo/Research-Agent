# ---------------------------------------------------------------------------
# مقرر اللجنة العلمية — مثال إعدادات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تضع أي مفتاح حقيقي في المستودع.
# ملف .env مستبعد من git عبر .gitignore.
# ---------------------------------------------------------------------------

# --- الخادم ---
# المنفذ المحلي لواجهة البرمجة.
PORT=4000
# العنوان الذي يستمع عليه الخادم. اتركه على 127.0.0.1 للتشغيل المحلي لمستخدم واحد.
# تغييره إلى 0.0.0.0 يفتح التطبيق لبقية الشبكة بلا أي تسجيل دخول أو صلاحيات — لا تفعل ذلك.
HOST=127.0.0.1

# --- التخزين ---
# مجلد البيانات: قاعدة البيانات والملفات المرفوعة. مستبعد من git.
DATA_DIR=./data
# الحد الأقصى لحجم الملف المرفوع بالميجابايت.
MAX_UPLOAD_MB=25

# --- خدمة التحليل الآلي (اختيارية بالكامل) ---
# إن تُرك AI_API_KEY فارغًا يعمل التطبيق كاملًا بلا تحليل آلي، ويعرض
# «التحليل الآلي غير مفعّل» بدل إنتاج نتائج غير مسنودة.
# المفتاح يُقرأ من جهة الخادم فقط ولا يُرسل إلى المتصفح مطلقًا.
# لا تستخدم اشتراك Claude Code أو أي جلسة مساعد كمفتاح لهذا التطبيق.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=120000

# عند تفعيل التحليل الآلي تُرسل إلى مزوّد الخدمة: المقاطع النصية المستخرجة من
# اللوائح والمرفقات المختارة، وبيانات الطلب الوصفية. لا تُرسل الملفات الأصلية.
# لا تُرسل أي بيانات إطلاقًا ما دام المفتاح فارغًا.
